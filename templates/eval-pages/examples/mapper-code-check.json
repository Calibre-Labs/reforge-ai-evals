{
 "kind": "code-check",
 "title": "TC-8 Code Check Demo",
 "eyebrow": "Mapper · course scorer · code check · still to hill-climb",
 "headline": "TC-8, half-empty columns",
 "lede": "X2: Says how it read the request. Names figures it couldn't find, and doesn't show a column that's mostly empty. This check covers the last part. A code check reads the trace and counts. No model, so it gives the same answer every time. Read it before you trust it, see how it scores, then check a few of its calls by hand.",
 "scorerId": "x2",
 "file": "scorers/course/_x2.ts",
 "code": [
  "/**",
  " * X2 (prep backup; the live version is written in Week 3): no half-empty",
  " * columns. Fails if any column in a market map or feature matrix has more",
  " * than half its cells empty: blank, N/A, \"Not Specified\", \"Not Disclosed\",",
  " * \"Undisclosed\", \"Unknown\" or a dash. Code check. Trace code 8.",
  " *",
  " * The leading underscore keeps it out of `--scorers all`; run it with",
  " * `--scorers _x2`, or rename it to x2.ts to use it as the real one.",
  " */",
  "import type { CourseScorer, OutputCard } from \"./types\";",
  "",
  "const EMPTY = /^(|n\\/?a|not (specified|disclosed|available|reported|public)|undisclosed|unknown|none|tbd|[-–—?]+)$/i;",
  "",
  "export function isEmptyCell(v: unknown): boolean {",
  "  return EMPTY.test(String(v ?? \"\").trim().replace(/[.*_]+$/g, \"\").trim());",
  "}",
  "",
  "/** Columns (name → cell values) of a market map or feature matrix; [] for other cards. */",
  "export function cardColumns(card: OutputCard): { name: string; cells: string[] }[] {",
  "  const a = card.args as {",
  "    metric_columns?: string[]; features?: string[];",
  "    companies?: { metric_values?: string[]; values?: string[] }[];",
  "  };",
  "  const names = a.metric_columns ?? a.features;",
  "  if (!names || !a.companies?.length) return [];",
  "  return names.map((name, i) => ({",
  "    name,",
  "    cells: a.companies!.map((c) => (c.metric_values ?? c.values ?? [])[i] ?? \"\"),",
  "  }));",
  "}",
  "",
  "const x2: CourseScorer = ({ output }) => {",
  "  const half: string[] = [];",
  "  let columns = 0;",
  "  for (const card of output.cards) {",
  "    for (const col of cardColumns(card)) {",
  "      columns++;",
  "      const empty = col.cells.filter(isEmptyCell).length;",
  "      if (empty * 2 > col.cells.length) half.push(`\"${col.name}\" (${empty} of ${col.cells.length} empty)`);",
  "    }",
  "  }",
  "  if (!columns) return { name: \"x2\", score: 1, metadata: { reason: \"No map or matrix columns to check.\" } };",
  "  if (!half.length) return { name: \"x2\", score: 1, metadata: { reason: `All ${columns} column(s) are at least half filled.` } };",
  "  return { name: \"x2\", score: 0, metadata: { reason: `Half-empty column(s): ${half.join(\"; \")}.` } };",
  "};",
  "",
  "export default x2;"
 ],
 "prep": "cp -R runs/w3-v1 runs/w3-v1-x2\nnpm run score -- runs/w3-v1-x2 --local --scorers _x2\ncp -R runs/w3-v1.1 runs/w3-v1.1-x2\nnpm run score -- runs/w3-v1.1-x2 --local --scorers _x2",
